# GitLab origin. A path prefix is supported for self-managed installations.
GITLAB_URL=https://gitlab.example.com

# Personal, project, or OAuth access token. Never commit a real token.
GITLAB_TOKEN=

# WRITE tools are not registered unless this is explicitly enabled.
MCP_WRITE_ENABLED=false

# HTTP safety and pagination limits.
GITLAB_TIMEOUT_SECONDS=30
GITLAB_MAX_PAGES=100
GITLAB_READ_RETRIES=2

# Optional path to a PEM CA bundle for a self-managed GitLab instance.
GITLAB_CA_BUNDLE=

# Used only by the opt-in integration smoke test.
GITLAB_INTEGRATION_PROJECT_URL=
